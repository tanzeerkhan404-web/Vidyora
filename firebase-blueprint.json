          "description": "Selected study note format."
        },
        "designStyle": {
          "type": "string",
          "enum": ["handwritten", "professional", "infographic", "minimal"],
          "description": "Selected visual presentation theme."
        },
        "payloadJson": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80000,
          "description": "Bounded JSON string of sanitized structured study notes."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of note creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last note update."
        }
      },
      "required": [
        "userId",
        "title",
        "className",
        "subject",
        "noteType",
        "designStyle",
        "payloadJson",
        "createdAt",
        "updatedAt"
      ]
    },
    "QuizAttemptDoc": {
      "title": "QuizAttemptDoc",
