          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of quiz completion."
        }
      },
      "required": [
        "userId",
        "title",
        "topic",
        "subject",
        "level",
        "difficulty",
        "score",
        "total",
        "percentage",
        "timeTakenSeconds",
        "payloadJson",
        "createdAt"
      ]
