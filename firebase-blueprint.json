          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Quiz title or topic label."
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Primary quiz topic."
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Quiz subject."
        },
        "level": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Selected class, college track, or exam."
        },
        "difficulty": {
          "type": "string",
          "enum": ["Easy", "Medium", "Hard", "Mixed"],
          "description": "Quiz difficulty setting."
        },
        "score": {
          "type": "number",
          "description": "Correct answers earned (0 to 50)."
        },
        "total": {
          "type": "number",
          "description": "Total questions in the quiz (1 to 50)."
        },
        "percentage": {
          "type": "number",
          "description": "Score percentage (0 to 100)."
        },
        "timeTakenSeconds": {
          "type": "number",
