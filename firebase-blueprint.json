{
  "entities": {
    "VideoLessonDoc": {
      "title": "VideoLessonDoc",
      "description": "An administrator-managed video lesson stored in Firestore with curriculum placement, validated video URL, thumbnail, optional study notes, and publish status.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "description": "Lesson title displayed to students."
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1500,
          "description": "Short Hinglish/English summary of what the video teaches."
        },
        "category": {
          "type": "string",
          "enum": ["school", "college", "competitive", "gk"],
          "description": "Primary learning track category."
        },
        "className": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60,
          "description": "Class name (e.g. Class 1 to Class 12) or track level."
        },
        "subject": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Subject name such as Mathematics, Physics, Chemistry, Biology."
        },
        "chapterNumber": {
          "type": "number",
          "description": "Numeric chapter sequence order (1 to 50)."
        },
        "chapterName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Chapter title."
        },
        "duration": {
          "type": "string",
          "minLength": 3,
          "maxLength": 20,
          "description": "Formatted duration string such as 12:40."
        },
        "difficulty": {
          "type": "string",
          "enum": ["Beginner", "Intermediate", "Advanced"],
          "description": "Lesson difficulty tier."
        },
        "videoUrl": {
          "type": "string",
          "minLength": 8,
          "maxLength": 500,
          "pattern": "^https://.*$",
          "description": "Legitimate HTTPS YouTube or direct HTML5 video URL."
        },
        "thumbnailUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 350000,
          "description": "HTTPS thumbnail URL, built-in /src/assets path, or resized JPEG/WebP data URI."
        },
        "notesContent": {
          "type": "string",
          "maxLength": 8000,
          "description": "Optional downloadable Hinglish revision notes text."
        },
        "practiceQuestions": {
          "type": "array",
          "description": "Optional bounded array of up to 10 practice MCQs."
        },
        "published": {
          "type": "boolean",
          "description": "Whether the lesson is visible to students."
        },
        "isDemo": {
          "type": "boolean",
          "description": "Marks demonstration sample content clearly."
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the administrator who created the lesson."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of lesson creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "title",
        "description",
        "category",
        "className",
        "subject",
        "chapterNumber",
        "chapterName",
        "duration",
        "difficulty",
        "videoUrl",
        "thumbnailUrl",
        "published",
        "isDemo",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "StudentProgressDoc": {
      "title": "StudentProgressDoc",
      "description": "Private student learning progress storing completed lessons, favourite lessons, and recently watched history without PII.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Student first name or display label."
        },
        "level": {
          "type": "string",
          "enum": [
            "Class 1-5",
            "Class 6-8",
            "Class 9-10",
            "Class 11-12",
            "College",
            "Competitive Exams"
          ],
          "description": "Preferred learning level."
        },
        "completedLessonIds": {
          "type": "array",
          "description": "Bounded list (max 500) of completed lesson IDs."
        },
        "favouriteLessonIds": {
          "type": "array",
          "description": "Bounded list (max 200) of saved favourite lesson IDs."
        },
        "recentLessonIds": {
          "type": "array",
          "description": "Bounded list (max 50) of recently watched lesson IDs."
        },
        "subjectsOfInterest": {
          "type": "array",
          "description": "Optional bounded list (max 12) of student subjects of interest."
        },
        "weeklyLessonGoal": {
          "type": "number",
          "description": "Optional weekly completed lesson goal (1 to 50)."
        },
        "studyActivityDates": {
          "type": "array",
          "description": "Optional bounded list (max 60) of YYYY-MM-DD active study dates for streak calculation."
        },
        "downloadedNoteIds": {
          "type": "array",
          "description": "Optional bounded list (max 200) of downloaded note IDs."
        },
        "completedPlanBlockIds": {
          "type": "array",
          "description": "Optional bounded list (max 50) of completed study planner block IDs."
        },
        "studyPlanJson": {
          "type": "string",
          "maxLength": 20000,
          "description": "Optional bounded JSON string of the student's active study plan."
        },
        "accountStatus": {
          "type": "string",
          "enum": ["active", "suspended"],
          "description": "Account standing managed by authorized administrators."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last progress update."
        }
      },
      "required": [
        "userId",
        "displayName",
        "level",
        "completedLessonIds",
        "favouriteLessonIds",
        "recentLessonIds",
        "updatedAt"
      ]
    },
    "StudyChatDoc": {
      "title": "StudyChatDoc",
      "description": "Private AI Study Buddy conversation stored for logged-in verified students without sensitive personal information.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Short sanitized conversation title derived from the student's first study question."
        },
        "subject": {
          "type": "string",
          "enum": [
            "Mathematics",
            "Physics",
            "Chemistry",
            "Biology",
            "English",
            "History",
            "Geography",
            "Computer Science",
            "General Knowledge"
          ],
          "description": "Selected study subject."
        },
        "level": {
          "type": "string",
          "enum": [
            "Beginner",
            "School level",
            "College level",
            "Competitive exam level"
          ],
          "description": "Selected learning level."
        },
        "mode": {
          "type": "string",
          "enum": [
            "simple",
            "step-by-step",
            "real-life",
            "short-summary",
            "teacher"
          ],
          "description": "Selected explanation mode."
        },
        "messages": {
          "type": "array",
          "description": "Bounded list (max 40) of sanitized educational Q&A message maps."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of conversation creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last message update."
        }
      },
      "required": [
        "userId",
        "title",
        "subject",
        "level",
        "mode",
        "messages",
        "createdAt",
        "updatedAt"
      ]
    },
    "SavedNoteDoc": {
      "title": "SavedNoteDoc",
      "description": "Private AI-generated or edited study note saved by a verified student without sensitive personal information.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Sanitized study note title."
        },
        "className": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Selected class or study track."
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Selected subject."
        },
        "chapterName": {
          "type": "string",
          "maxLength": 140,
          "description": "Optional chapter name."
        },
        "noteType": {
          "type": "string",
          "enum": [
